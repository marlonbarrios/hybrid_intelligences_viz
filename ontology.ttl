<https://marlonbarrios.github.io/hybrid-intelligences/ontology> a owl:Ontology ;
  rdfs:label "Hybrid Intelligences Ontology" ;
  dc:title "Hybrid Intelligences: Embodied Leadership and Creativity in the Era of AI" ;
  owl:versionInfo "1.0.0" ;
  hi:nodeCount "222"^^xsd:integer ;
  hi:edgeCount "2188"^^xsd:integer .

hi:scheme a skos:ConceptScheme ;
  skos:prefLabel "Hybrid Intelligences Concept Scheme" ;
  skos:hasTopConcept hi:category/program, hi:category/organization, hi:category/premise, hi:category/participant, hi:category/background, hi:category/facilitator, hi:category/practice, hi:category/tension, hi:category/quality, hi:category/phenomenon, hi:category/domain, hi:category/framework, hi:category/author .

hi:category/program a skos:Concept, hi:Category ;
  skos:prefLabel "Program" ;
  skos:definition "The Hybrid Intelligences program, its three tracks, and public events." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.09"^^xsd:decimal ;
  hi:ringOrder "0"^^xsd:integer .

hi:category/organization a skos:Concept, hi:Category ;
  skos:prefLabel "Organizations" ;
  skos:definition "Host institutions and partners—College of the Arts (COA), CAME, CAM, IGNITE, Wertheim Laboratory, and Gainesville Circus Center." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.16"^^xsd:decimal ;
  hi:ringOrder "1"^^xsd:integer .

hi:category/premise a skos:Concept, hi:Category ;
  skos:prefLabel "Premise" ;
  skos:definition "Core starting ideas—intelligence as coupling across bodies, tools, and worlds." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.23"^^xsd:decimal ;
  hi:ringOrder "2"^^xsd:integer .

hi:category/participant a skos:Concept, hi:Category ;
  skos:prefLabel "Participants" ;
  skos:definition "Cohort of the Hybrid Intelligences program—undergraduate and graduate students, UF staff, community members, alumni, and former faculty across arts, engineering, health, and media." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.3"^^xsd:decimal ;
  hi:ringOrder "3"^^xsd:integer .

hi:category/background a skos:Concept, hi:Category ;
  skos:prefLabel "Backgrounds" ;
  skos:definition "Formative backgrounds of the Hybrid Intelligences cohort—academic majors, professional formations, and community practices that participants bring into the room." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.37"^^xsd:decimal ;
  hi:ringOrder "4"^^xsd:integer .

hi:category/facilitator a skos:Concept, hi:Category ;
  skos:prefLabel "Facilitators" ;
  skos:definition "Hybrid Intelligences session leaders and guest facilitators." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.44"^^xsd:decimal ;
  hi:ringOrder "5"^^xsd:integer .

hi:category/practice a skos:Concept, hi:Category ;
  skos:prefLabel "Practices" ;
  skos:definition "Methods and habits—rehearsal, somatics, pedagogy, cultural critique." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.51"^^xsd:decimal ;
  hi:ringOrder "6"^^xsd:integer .

hi:category/tension a skos:Concept, hi:Category ;
  skos:prefLabel "Tensions" ;
  skos:definition "Inadequate or contested positions the network holds open to critique." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.58"^^xsd:decimal ;
  hi:ringOrder "7"^^xsd:integer .

hi:category/quality a skos:Concept, hi:Category ;
  skos:prefLabel "Qualities" ;
  skos:definition "Traits of hybrid cognition—embodied, situated, distributed, critical." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.65"^^xsd:decimal ;
  hi:ringOrder "8"^^xsd:integer .

hi:category/phenomenon a skos:Concept, hi:Category ;
  skos:prefLabel "Phenomena" ;
  skos:definition "Observable dynamics—mediation, symbiosis, community, theory of mind." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.72"^^xsd:decimal ;
  hi:ringOrder "9"^^xsd:integer .

hi:category/domain a skos:Concept, hi:Category ;
  skos:prefLabel "Domains" ;
  skos:definition "Fields of practice and inquiry—art, law, ecology, AI, choreography." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.8"^^xsd:decimal ;
  hi:ringOrder "10"^^xsd:integer .

hi:category/framework a skos:Concept, hi:Category ;
  skos:prefLabel "Framework" ;
  skos:definition "Conceptual models for cognition, AI, embodiment, and world-making." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.87"^^xsd:decimal ;
  hi:ringOrder "11"^^xsd:integer .

hi:category/author a skos:Concept, hi:Category ;
  skos:prefLabel "Authors/Artists" ;
  skos:definition "Thinkers, artists, and researchers linked to concepts in the network." ;
  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.95"^^xsd:decimal ;
  hi:ringOrder "12"^^xsd:integer .

hi:coupling a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Intelligence as Coupling" ;
  skos:definition "Intelligence is not located in a skull or machine—it is a relational event happening through bodies, tools, architectures, and co-presence." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "2.2"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Distributed_cognition>
 .

hi:hybrid a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Hybrid Intelligences" ;
  skos:definition "Assemblages of biological, technical, social, spatial, legal, and affective processes that co-produce cognition." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "2"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Cognitive_architecture>
 .

hi:creative_embodiment a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Creative Embodiment" ;
  skos:definition "The project's embodiment framework: AI-mediated creative process is already embodied, situated, and relational—not a body added after the fact. The artist designs conditions of encounter; prompt, model, interface, dataset, institution, and audience form a cognitive assemblage. Necessary epistemology: the body is where abstraction becomes consequential; space situates cognition; movement temporalizes thought." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "1.9"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Embodied_cognition>
 .

hi:intelligence a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Intelligence" ;
  skos:definition "The capacity to perceive, infer, learn, adapt, and act in relation to an environment—not a substance locked in a skull or chip, but a capacity enacted through coupling among bodies, tools, symbols, institutions, and ecologies." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "1.9"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Intelligence> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Intelligence>
 .

hi:embodiment a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Embodiment" ;
  skos:definition "The condition of being a living body in a world—mind, affect, and meaning arising through sensorimotor engagement rather than added to a disembodied processor." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "1.8"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Embodied_cognition> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Embodied_cognition>
 .

hi:body a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Body" ;
  skos:definition "The lived organism—flesh, breath, gesture, and sensation—as the primary site where cognition, emotion, relation, and creative action become real and consequential." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "1.7"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Human_body> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Human_body>
 .

hi:hybrid_coupling a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Hybrid" ;
  skos:definition "The mixing of biological, technical, social, and institutional processes within a single field of action—neither purely human nor purely machine, but co-produced across coupled agents, infrastructures, and ecologies." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "1.7"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Hybrid> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Hybrid>
 .

hi:assemblage a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Cognitive Assemblages" ;
  skos:definition "N. Katherine Hayles: cognition as interpretation of information within contexts that connect it with meaning—networked arrangements in which human and nonhuman cognizers exchange, process, select, and transform information, producing emergent meaning and action. Intelligence does not belong to one sovereign subject; it circulates through bodies, sensors, interfaces, datasets, institutions, and environments." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "2.05"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/N._Katherine_Hayles>
 .

hi:assemblage_form a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Assemblage" ;
  skos:definition "A composition of heterogeneous parts—bodies, tools, institutions, laws, media, atmospheres—whose relations co-produce capacities and meaning. Not a collection of fixed objects, but a dynamic arrangement; related to Hayles’s cognitive assemblages and to broader assemblage thinking (Latour, Deleuze & Guattari)." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "1.85"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Assemblage_(philosophy)> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Assemblage_(philosophy)>
 .

hi:technosymbiosis a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Techno-symbiosis" ;
  skos:definition "N. Katherine Hayles: human futures with nonhuman symbionts—biological, technical, and mixed couplings that co-evolve across substrates, institutions, and AI systems. Techno-symbiosis names interdependence without sameness: humans and machines do not collapse into one another, yet their metabolisms of information, energy, and action become mutually constitutive." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "1.95"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/N._Katherine_Hayles>
 .

hi:cognition a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Cognition" ;
  skos:definition "Processes of knowing, perceiving, remembering, imagining, and deciding—historically located in brains, now understood as spanning bodies, environments, tools, and collectives. In this program, cognition is a world-involving practice, not an abstract operation floating above situation." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "1.95"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Cognition>
 .

hi:4e a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "4E Cognition" ;
  skos:definition "Embodied cognition as four coupled claims: Embodied (depends on sensorimotor capacities of living bodies), Embedded (emerges within environments that constrain and enable action), Enacted (organisms bring forth meaningful worlds through interaction histories), and Extended (tools, inscriptions, devices, media, and social structures can participate in cognitive processes). Challenges the classical image of mind as internal representation in a brain-computer." ;
  skos:broader hi:category/premise ;
  skos:inScheme hi:scheme ;
  hi:category "premise" ;
  hi:weight "2"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Embodied_cognition>
 .

hi:creativity a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Creativity" ;
  skos:definition "Margaret Boden: an idea or artifact counts as creative only when it is both novel (surprising, not obvious or routine) and valuable (worthwhile in its domain—useful, interesting, beautiful, or apt). She distinguishes combinational creativity (new combinations of familiar elements), exploratory creativity (moving within a structured conceptual space), and transformational creativity (altering the space's rules or dimensions)." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.8"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Creativity> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Creativity>
 .

hi:enactivism a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Enactivism" ;
  skos:definition "Organisms bring forth meaningful worlds through histories of interaction; cognition and world are co-emergent." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.7"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Enactivism>
 .

hi:buddhism a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Buddhism" ;
  skos:definition "Tradition of practice and philosophy centered on suffering, interdependence, impermanence, and liberation—mindfulness, emptiness (śūnyatā), and non-self (anattā) as frameworks for understanding cognition, ethics, and embodied experience; foundational for enactivism via phenomenology and contemplative science." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.5"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Buddhism> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Buddhism>
 .

hi:active_inference a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Active Inference" ;
  skos:definition "Karl Friston's framework—perception, action, and planning as Bayesian inference minimizing free energy; minds predict and act to reduce surprise through embodied coupling with the world." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.5"^^xsd:decimal
 ;
  schema:sameAs <https://en.wikipedia.org/wiki/Active_inference>
 .

hi:extended a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Extended Mind" ;
  skos:definition "Cognitive processes include tools, inscriptions, devices, media, and social structures beyond the organism." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.4"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Extended_mind_thesis>
 .

hi:cyborg a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Natural-Born Cyborg" ;
  skos:definition "Clark: humans have always been technologically plastic, incorporating tools into the fabric of thought." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.5"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Cyborg>
 .

hi:cyberfeminism a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Cyber- feminism" ;
  skos:definition "Feminist critique and practice at the intersection of gender, technology, and cyberspace—from 1990s net activism through Haraway's cyborg politics to contemporary feminist AI critique; technologies are never neutral, and liberation requires reworking gender, labor, and embodiment in digital infrastructures." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.4"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Cyberfeminism> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Cyberfeminism>
 .

hi:queer_theory a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Queer Theory" ;
  skos:definition "Critical framework questioning normative categories of gender, sexuality, and identity—drawing on Foucault, Sedgwick, and Muñoz to analyze how power produces the 'normal,' open performative accounts of subjectivity, and orient imagination toward queer futurity and world-making beyond heteronormative scripts." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.4"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Queer_theory> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Queer_theory>
 .

hi:possible_minds a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Space of Possible Minds" ;
  skos:definition "Intelligence as a vast landscape of cognitive organizations—not a ladder with humans at the top." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.4"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Philosophy_of_artificial_intelligence>
 .

hi:holobiont a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Holobiont" ;
  skos:definition "A host organism together with its associated microorganisms as a functional unit—evolution, metabolism, immunity, and behavior distributed across symbiotic partners. A biological framework for hybrid life: the individual is already an ecology." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.5"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Holobiont> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Holobiont>
 .

hi:affordances a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Affordances" ;
  skos:definition "Gibson: environments offer possibilities for action—what a situation allows, invites, or constrains for a particular organism or assemblage." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.5"^^xsd:decimal
 ;
  schema:url <essay-2.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Affordance>
 .

hi:umwelt a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Umwelt" ;
  skos:definition "von Uexküll: the organism's lived meaningful environment—the world as selectively enacted through sensing, action, and coupling, not a pre-given objective space." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.4"^^xsd:decimal
 ;
  schema:url <essay-2.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Umwelt>
 .

hi:ai a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Artificial Intelligence" ;
  skos:definition "Computational systems that infer, classify, generate, and act within human-designed environments—participants in cognitive assemblages, not minds in boxes." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.8"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Artificial_intelligence> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Artificial_intelligence>
 .

hi:machine_learning a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Machine Learning" ;
  skos:definition "Algorithms that learn patterns from data to infer, classify, predict, and generate—training models on examples rather than hand-coded rules; the core computational paradigm behind contemporary AI systems and hybrid couplings." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.7"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Machine_learning> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Machine_learning>
 .

hi:neural_networks a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Neural Networks" ;
  skos:definition "Layered computational models of interconnected units that transform inputs through weighted connections and nonlinear activation—architectures that learn distributed representations and underpin deep learning, language models, and generative systems." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.7"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Neural_network_(machine_learning)> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Neural_network_(machine_learning)>
 .

hi:perceptron a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Perceptron" ;
  skos:definition "Foundational unit of artificial neural networks—a weighted threshold classifier proposed by Frank Rosenblatt (1958); the historical bridge from cybernetics to modern machine learning." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.4"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Perceptron> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Perceptron>
 .

hi:linear_transform a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "z = Wx + b" ;
  skos:definition "The affine transform at the heart of every dense layer: each output unit j computes zⱼ = Σᵢ wⱼᵢ xᵢ + bⱼ (matrix form z = Wx + b)—a weighted sum of inputs plus bias—before a nonlinear activation. The elementary operation of artificial neurons, shared by perceptrons, deep nets, and transformers." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.55"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Artificial_neuron> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Artificial_neuron>
 .

hi:rnn_update a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "σ(Wₓx + Wₕh + b)" ;
  skos:definition "Recurrent update (and LSTM/GRU gate form): σ(Wₓxₜ + Wₕhₜ₋₁ + b)—combine current input xₜ with previous hidden state hₜ₋₁ through separate weight matrices, add bias, then apply nonlinearity σ. Memory through time via recurrence; the sequential counterpart to the feedforward affine layer z = Wx + b. Foundational for sequence modeling; largely succeeded for long context by transformers." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.5"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Recurrent_neural_network> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Recurrent_neural_network>
 .

hi:convolutional_networks a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Convolutional Neural Networks" ;
  skos:definition "Neural architectures that learn spatial hierarchies through local receptive fields and shared weights—dominant in computer vision, image generation, and perceptual classification; central to how machines learn to see." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.5"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Convolutional_neural_network> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Convolutional_neural_network>
 .

hi:transformers a skos:Concept, hi:NetworkNode ;
  skos:prefLabel "Transformers (Attention Is All You Need)" ;
  skos:definition "Vaswani et al. (2017)—architecture built on self-attention rather than recurrence, enabling parallel training and long-range dependency modeling; the foundation of modern language models, GPTs, and multimodal generative systems." ;
  skos:broader hi:category/framework ;
  skos:inScheme hi:scheme ;
  hi:category "framework" ;
  hi:weight "1.6"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Transformer_(deep_learning_architecture)> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Transformer_(deep_learning_architecture)>
 .

