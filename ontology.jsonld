    {
      "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#ai_impact_environment",
      "@type": [
        "skos:Concept",
        "hi:NetworkNode"
      ],
      "skos:prefLabel": "Environmental (AI Impact)",
