    {
      "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#three_es_ai",
      "@type": [
        "skos:Concept",
        "hi:NetworkNode"
      ],
      "skos:prefLabel": "3 E's of AI Impact",
      "skos:definition": "Kate Crawford’s notion of AI impact across three coupled registers: environmental (extraction, energy, water, ecologies), ethics (labor, bias, governance, harm), and epistemological (classification, knowledge, and what counts as real). These are not separate aftermaths of computation; they are how AI already organizes worlds.",
      "skos:broader": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#category/framework"
      },
