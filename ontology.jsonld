    {
      "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#autopoiesis",
      "@type": [
        "skos:Concept",
        "hi:NetworkNode"
      ],
      "skos:prefLabel": "Autopoiesis",
      "skos:definition": "Humberto Maturana and Francisco Varela: living systems as networks that continually produce and regenerate the components and boundaries that constitute them. An autopoietic unity is operationally closed—it specifies its own organization—yet structurally coupled with a medium. Cognition, in this biology of knowing, is the effective conduct of a living system in its world, not representation of a pre-given environment. Autopoiesis is the biological root of enactivism: organisms bring forth worlds because they first bring forth themselves.",
      "skos:broader": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#category/framework"
      },
      "skos:inScheme": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#scheme"
