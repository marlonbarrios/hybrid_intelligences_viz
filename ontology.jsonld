    {
      "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#enactivism",
      "@type": [
        "skos:Concept",
        "hi:NetworkNode"
      ],
      "skos:prefLabel": "Enactivism",
      "skos:definition": "Organisms bring forth meaningful worlds through histories of interaction; cognition and world are co-emergent. Rooted in Maturana and Varela’s autopoiesis: a living system first produces itself, then a world of significance.",
      "skos:broader": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#category/framework"
      },
      "skos:inScheme": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#scheme"
      },
      "hi:category": "framework",
      "hi:weight": 1.7,
      "schema:url": "essay.html",
      "schema:sameAs": "https://en.wikipedia.org/wiki/Enactivism",
      "skos:related": [
        {
          "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#coupling",
          "hi:strength": 0.85
        },
        {
          "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#rehearsal",
          "hi:strength": 0.7
        },
        {
          "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#autopoiesis",
          "hi:strength": 0.95
        }
      ]
    },
    {
      "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#autopoiesis",
      "@type": [
        "skos:Concept",
        "hi:NetworkNode"
      ],
      "skos:prefLabel": "Autopoiesis",
      "skos:definition": "Humberto Maturana and Francisco Varela: living systems as networks that continually produce and regenerate the components and boundaries that constitute them. An autopoietic unity is operationally closed—it specifies its own organization—yet structurally coupled with a medium. Cognition, in this biology of knowing, is the effective conduct of a living system in its world, not representation of a pre-given environment. Autopoiesis is the biological root of enactivism: organisms bring forth worlds because they first bring forth themselves.",
      "skos:broader": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#category/framework"
      },
      "skos:inScheme": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#scheme"
      },
      "hi:category": "framework",
      "hi:weight": 1.65,
      "schema:url": "https://en.wikipedia.org/wiki/Autopoiesis",
      "schema:sameAs": "https://en.wikipedia.org/wiki/Autopoiesis",
      "skos:related": [
        {
          "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#maturana",
          "hi:strength": 0.98
