    {
      "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#enact",
      "@type": [
        "skos:Concept",
        "hi:NetworkNode"
      ],
      "skos:prefLabel": "Enact",
      "skos:definition": "Cognitive prompts for a choreography of awareness — short invitations, in the spirit of Oblique Strategies, generated from Hybrid Intelligences. Grounded in this coupling: you, the computer, an intelligent non-organic machine, data moving through networks, and a body of cells, metabolism, and symbionts. Touch, sight, breath. A hybrid epistemology beyond the human, as a tiny dance of attention, not a lecture. Tap for another. Marin can speak the invitation.",
      "skos:broader": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#category/practice"
