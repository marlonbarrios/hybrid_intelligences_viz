    {
      "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#essay_2",
      "@type": [
        "skos:Concept",
        "hi:NetworkNode"
      ],
      "skos:prefLabel": "Essay 2",
      "skos:definition": "My Umwelt — Essay 2 by Marlon Barrios Solano, in conversation with GPT-5.5 (July 20, 2026). A first-person inquiry into lived worlds: Uexküll’s Umwelt, enactivism, and what a language model’s possible world (a Latentwelt) might be. Authored by Marlon; the conversation with the model is method, not a guest byline.",
      "skos:broader": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#category/practice"
      },
      "skos:inScheme": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#scheme"
      },
      "hi:category": "practice",
      "hi:weight": 1.5,
      "schema:url": "essay-2.html",
