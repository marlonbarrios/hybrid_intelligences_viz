    {
      "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#ontology_kb",
      "@type": [
        "skos:Concept",
        "hi:NetworkNode"
      ],
      "skos:prefLabel": "Ontology as Knowledge Base",
      "skos:definition": "The Hybrid Intelligences ontology as a living vocabulary that grounds the conversational AI. Concepts, definitions, weighted relatedTo edges, and a seed of typed verbs (couples with, enables, mediates, cultivates, constrains, participates in, critiques, proposes, instantiates, develops, enacts, embodies, emerges from) are the source of truth the spoken companion is given — a situated knowledge base rather than a generic model talking about the program from outside. Essays feed this scheme; the network makes it visible; Voice, Image, Mini-pod, and Enact generate from it. Essay 3 describes this as three layers — concept scheme, knowledge graph, and formal OWL ontology — with those thirteen verbs as first-class object properties.",
      "skos:broader": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#category/practice"
      },
      "skos:inScheme": {
        "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#scheme"
