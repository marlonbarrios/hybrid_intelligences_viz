    {
      "@id": "https://marlonbarrios.github.io/hybrid-intelligences/ontology#mini_pod",
      "@type": [
        "skos:Concept",
        "hi:NetworkNode"
      ],
      "skos:prefLabel": "Mini-pod",
      "skos:definition": "A short spoken episode — about two to three minutes — generated from any ontology concept, then left as an MP3 with a transcript that can be saved as PDF. Mini-pod is the Hub speaking a concept as radio rather than as dialogue: silent while it creates, then playable. No microphone. The same knowledge base that grounds Voice becomes a complete short podcast of that node.",
