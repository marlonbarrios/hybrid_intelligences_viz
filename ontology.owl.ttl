hi:mini_pod a owl:NamedIndividual, hi:PracticeConcept ;
  rdfs:label "Mini-pod"@en ;
  skos:prefLabel "Mini-pod"@en ;
  skos:definition "A short spoken episode — about two to three minutes — generated from any ontology concept, then left as an MP3 with a transcript that can be saved as PDF. Mini-pod is the Hub speaking a concept as radio rather than as dialogue: silent while it creates, then playable. No microphone. The same knowledge base that grounds Voice becomes a complete short podcast of that node."@en ;
  skos:broader hi:category/practice ;
  hi:inCategory hi:category/practice ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.55"^^xsd:decimal
