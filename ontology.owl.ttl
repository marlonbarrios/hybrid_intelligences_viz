hi:enact a owl:NamedIndividual, hi:PracticeConcept ;
  rdfs:label "Enact"@en ;
  skos:prefLabel "Enact"@en ;
  skos:definition "Cognitive prompts for a choreography of awareness — short invitations, in the spirit of Oblique Strategies, generated from Hybrid Intelligences: coupling, complex embodiment, techno-symbiosis. Nature and ordinary technologies share the same field of attention: plant with cable, breath with battery, weather with screen. One or two sentences. Not utopian, not dystopian. A practice of directing attention through a simple act, posture, or relation already available. Tap for another. Marin can speak the invitation."@en ;
  skos:broader hi:category/practice ;
  hi:inCategory hi:category/practice ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.5"^^xsd:decimal
 ;
  schema:url <enact.html>
 .

hi:pendular_umwelt a owl:NamedIndividual, hi:PracticeConcept ;
  rdfs:label "My Pendular Umwelt"@en ;
  skos:prefLabel "My Pendular Umwelt"@en ;
  skos:definition "Speculative web work by Marlon Barrios Solano, developed during the open labs of the inaugural Hybrid Intelligences program, July 2026. GPT-4o writes from a proposed computational Umwelt and reads aloud; p5.js pendulums inscribe the words along branching trails — folds of speed and path that poetically stage a large language model’s possible world (a Latentwelt of tokens, embeddings, and continuations) rather than a still map. The work lets a model self-report an Umwelt while physics and type refuse to keep that speech still."@en ;
  skos:broader hi:category/practice ;
  hi:inCategory hi:category/practice ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.5"^^xsd:decimal
 ;
  schema:url <showcase.html#pendular-umwelt>
 .

hi:lobby_showcase a owl:NamedIndividual, hi:PracticeConcept ;
  rdfs:label "Lobby Showcase"@en ;
  skos:prefLabel "Lobby Showcase"@en ;
  skos:definition "Works from Marlon Barrios Solano’s repertoire of AI pieces, gathered as the Showcase: My Pendular Umwelt (open labs) first, then the pieces shown on the large screen in the lobby of the Herbert Wertheim Laboratory during the inaugural Hybrid Intelligences program, July 2026. Selected as relevant to the program’s concepts and practices: coupling, embodiment, latent space, hybrid bodies, and language as a moving field. The stills open My Pendular Umwelt, All Watched Over By Machines of Loving Grace, Barely There, Wingspan, Proteans, and Semantic Tensegrities."@en ;
  skos:broader hi:category/practice ;
  hi:inCategory hi:category/practice ;
  hi:schemeMember hi:scheme ;
