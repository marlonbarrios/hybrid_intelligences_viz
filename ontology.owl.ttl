  rdfs:label "3 E's of AI Impact"@en ;
  skos:prefLabel "3 E's of AI Impact"@en ;
  skos:definition "Kate Crawford’s notion of AI impact across three coupled registers: environmental (extraction, energy, water, ecologies), ethics (labor, bias, governance, harm), and epistemological (classification, knowledge, and what counts as real). These are not separate aftermaths of computation; they are how AI already organizes worlds."@en ;
  skos:broader hi:category/framework ;
  hi:inCategory hi:category/framework ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.5"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Kate_Crawford>
 .

