 ;
  schema:url <https://artsinmedicine.ufhealth.org/about/jackie-larson-dancer-in-residence/> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Dance_movement_therapy>
 .

hi:andrew_hix a owl:NamedIndividual, hi:FacilitatorConcept ;
  rdfs:label "Andrew Hix"@en ;
  skos:prefLabel "Andrew Hix"@en ;
  skos:definition "Wednesday July 22 — Future Lab: sound and listening. Writer, storyteller, and integrative therapies practitioner at UF Health Shands Arts in Medicine; licensed massage therapist who teaches tai chi, qigong, and mindfulness meditation to hospital patients. University of Florida graduate (2009) and Florida School of Massage (2011); co-principal investigator on integrative-medicine studies. Practices tai chi as a martial art; attention and listening as method."@en ;
  skos:broader hi:category/facilitator ;
  hi:inCategory hi:category/facilitator ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.1"^^xsd:decimal
 ;
  schema:url <https://artsinmedicine.ufhealth.org/about/andrew-hix-lmt-tai-chiqigong-practitioner-massage-therapist/> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Music_therapy>
 .

hi:turbado_marabou a owl:NamedIndividual, hi:FacilitatorConcept ;
  rdfs:label "Turbado Marabou"@en ;
  skos:prefLabel "Turbado Marabou"@en ;
  skos:definition "Wednesday July 29 — Future Lab: themes, insights, and artifacts. Gainesville visual artist, muralist, folklorist, and educator; BFA (Florida A&M), MFA (University of Wisconsin–Madison), doctoral candidate in Arts Education (Florida State). Founder of Deeproots Arts & Culture Creative Services; more than three decades of Afrocentric cultural practice using visual and performing arts for storytelling, cultural preservation, and community empowerment across the African diaspora."@en ;
  skos:broader hi:category/facilitator ;
  hi:inCategory hi:category/facilitator ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
