hi:NetworkRelation a owl:Class ;
  rdfs:label "Network relation"@en ;
  rdfs:comment "A reified weighted edge between two concept individuals."@en .

hi:relatedTo a owl:ObjectProperty ;
  rdfs:label "related to"@en ;
  rdfs:domain hi:Concept ;
  rdfs:range hi:Concept ;
  owl:propertyType owl:SymmetricProperty .

hi:inCategory a owl:ObjectProperty ;
  rdfs:label "in category"@en ;
  rdfs:domain hi:Concept ;
  rdfs:range hi:CategoryConcept .

hi:schemeMember a owl:ObjectProperty ;
  rdfs:label "scheme member"@en ;
  rdfs:domain hi:Concept ;
  rdfs:range skos:ConceptScheme .

hi:relationSource a owl:ObjectProperty ;
  rdfs:label "relation source"@en ;
  rdfs:domain hi:NetworkRelation ;
  rdfs:range hi:Concept .

hi:relationTarget a owl:ObjectProperty ;
  rdfs:label "relation target"@en ;
  rdfs:domain hi:NetworkRelation ;
  rdfs:range hi:Concept .

hi:networkWeight a owl:DatatypeProperty ;
  rdfs:label "network weight"@en ;
  rdfs:domain hi:Concept ;
  rdfs:range xsd:decimal .

hi:relationStrength a owl:DatatypeProperty ;
  rdfs:label "relation strength"@en ;
  rdfs:domain hi:NetworkRelation ;
  rdfs:range xsd:decimal .

hi:ringFraction a owl:DatatypeProperty ;
  rdfs:label "ring fraction"@en ;
  rdfs:domain hi:CategoryConcept ;
  rdfs:range xsd:decimal .

hi:ringOrder a owl:DatatypeProperty ;
  rdfs:label "ring order"@en ;
  rdfs:domain hi:CategoryConcept ;
  rdfs:range xsd:integer .

hi:nodeCount a owl:DatatypeProperty ;
  rdfs:range xsd:integer .

hi:edgeCount a owl:DatatypeProperty ;
  rdfs:range xsd:integer .

