@prefix hi: <https://marlonbarrios.github.io/hybrid-intelligences/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://marlonbarrios.github.io/hybrid-intelligences/ontology> a owl:Ontology ;
  rdfs:label "Hybrid Intelligences Ontology" ;
  dc:title "Hybrid Intelligences: Embodied Leadership and Creativity in the Era of AI" ;
  dc:description "OWL 2 ontology of concepts, categories, and weighted relations from the Hybrid Intelligences program." ;
  owl:versionInfo "1.0.0" ;
  dc:date "2026-09-01"^^xsd:date ;
  dc:modified "2026-09-01T18:01:05.598Z"^^xsd:dateTime ;
  owl:imports <http://www.w3.org/2004/02/skos/core> ;
  hi:nodeCount "235"^^xsd:integer ;
  hi:edgeCount "2343"^^xsd:integer .

hi:Concept a owl:Class ;
  rdfs:label "Concept"@en ;
  rdfs:comment "Any concept node in the Hybrid Intelligences network."@en .

hi:CategoryConcept a owl:Class ;
  rdfs:label "Category concept"@en ;
  rdfs:subClassOf hi:Concept ;
  rdfs:comment "A ring category in the conceptual network visualization."@en .

hi:ProgramConcept a owl:Class ;
  rdfs:label "Program"@en ;
  rdfs:comment "The Hybrid Intelligences Hub (the public tool), the inaugural Creative B program (July 13–30, 2026), its three tracks, and public events."@en ;
  rdfs:subClassOf hi:Concept .

hi:OrganizationConcept a owl:Class ;
  rdfs:label "Organizations"@en ;
  rdfs:comment "Host institutions and partners—College of the Arts (COA), CAME, CAM, IGNITE, Wertheim Laboratory, and Gainesville Circus Center."@en ;
  rdfs:subClassOf hi:Concept .

hi:PremiseConcept a owl:Class ;
  rdfs:label "Framework"@en ;
  rdfs:comment "Core starting ideas—intelligence as coupling, hybrid intelligences, complex emergent embodiment, and leadership across bodies, tools, and worlds."@en ;
  rdfs:subClassOf hi:Concept .

hi:ParticipantConcept a owl:Class ;
  rdfs:label "Participants"@en ;
  rdfs:comment "Cohort of the inaugural Hybrid Intelligences program—undergraduate and graduate students, UF staff, community members, alumni, and former faculty across arts, engineering, health, and media."@en ;
  rdfs:subClassOf hi:Concept .

hi:BackgroundConcept a owl:Class ;
  rdfs:label "Backgrounds"@en ;
  rdfs:comment "Formative backgrounds of the Hybrid Intelligences cohort—academic majors, professional formations, and community practices that participants bring into the room."@en ;
  rdfs:subClassOf hi:Concept .

hi:FacilitatorConcept a owl:Class ;
  rdfs:label "Facilitators"@en ;
  rdfs:comment "Hybrid Intelligences session leaders and guest facilitators."@en ;
  rdfs:subClassOf hi:Concept .

hi:PracticeConcept a owl:Class ;
  rdfs:label "Practices"@en ;
  rdfs:comment "Methods and habits—rehearsal, somatics, pedagogy, cultural critique, conversational AI, Mini-pod, concept image, and the ontology as a knowledge base for the Hub."@en ;
  rdfs:subClassOf hi:Concept .

hi:TensionConcept a owl:Class ;
  rdfs:label "Tensions"@en ;
  rdfs:comment "Inadequate or contested positions the network holds open to critique."@en ;
  rdfs:subClassOf hi:Concept .

hi:QualityConcept a owl:Class ;
  rdfs:label "Qualities"@en ;
  rdfs:comment "Traits of hybrid cognition—embodied, situated, distributed, critical."@en ;
  rdfs:subClassOf hi:Concept .

hi:PhenomenonConcept a owl:Class ;
  rdfs:label "Phenomena"@en ;
  rdfs:comment "Observable dynamics—mediation, symbiosis, community, theory of mind."@en ;
  rdfs:subClassOf hi:Concept .

hi:DomainConcept a owl:Class ;
  rdfs:label "Domains"@en ;
  rdfs:comment "Fields of practice and inquiry—art, law, ecology, AI, choreography."@en ;
  rdfs:subClassOf hi:Concept .

hi:FrameworkConcept a owl:Class ;
  rdfs:label "Conceptual Models"@en ;
  rdfs:comment "Extended conceptual models for cognition, AI, embodiment, and world-making."@en ;
  rdfs:subClassOf hi:Concept .

hi:AuthorConcept a owl:Class ;
  rdfs:label "Authors/Artists"@en ;
  rdfs:comment "Thinkers, artists, and researchers linked to concepts in the network."@en ;
  rdfs:subClassOf hi:Concept .

