  schema:sameAs <https://en.wikipedia.org/wiki/Medical_humanities>
 .

hi:jackie_larson a owl:NamedIndividual, hi:FacilitatorConcept ;
  rdfs:label "Jackie Larson"@en ;
  skos:prefLabel "Jackie Larson"@en ;
  skos:definition "Wednesday July 15 — Future Lab: movement and mapping possible futures. Dancer in residence at UF Health Shands Arts in Medicine; head ballet instructor and former hospital nurse (UF Health and Haven Hospice). Trained at Ballet Florida and South Florida Ballet Academy; longtime Gainesville resident who returned to UF Health to combine dance, nursing, and arts in medicine as movement for healing, reflection, and connection."@en ;
  skos:broader hi:category/facilitator ;
  hi:inCategory hi:category/facilitator ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
