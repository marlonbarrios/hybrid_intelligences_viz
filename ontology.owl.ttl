hi:hi_hub a owl:NamedIndividual, hi:ProgramConcept ;
  rdfs:label "Hybrid Intelligences Hub"@en ;
  skos:prefLabel "Hybrid Intelligences Hub"@en ;
  skos:definition "The public Hybrid Intelligences tool: a dynamic cognitive assemblage created by Marlon Barrios Solano as Maker-in-Residence at CAME. Not a brochure and not a chatbot in isolation — a hybrid instrument in which essays, ontology, network visualization, conversational AI, concept images, Mini-pods, and Enact couple. The ontology is the knowledge base that grounds Voice; from any concept one can talk, generate an image, or create a short spoken episode. Enact offers cognitive prompts for a choreography of awareness. Also called this site, this platform, or this knowledge architecture. When asked what the Hub or this tool is, describe it as that assemblage and refer to its layers by name."@en ;
  skos:broader hi:category/program ;
  hi:inCategory hi:category/program ;
