  skos:inScheme hi:scheme ;
  skos:topConceptOf hi:scheme ;
  hi:ringFraction "0.95"^^xsd:decimal ;
  hi:ringOrder "12"^^xsd:integer .

hi:coupling a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Intelligence as Coupling"@en ;
  skos:prefLabel "Intelligence as Coupling"@en ;
  skos:definition "Intelligence is not located in a skull or machine—it is a relational event happening through bodies, tools, architectures, and co-presence."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "2.2"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Distributed_cognition>
 .

hi:hybrid a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Hybrid Intelligences"@en ;
  skos:prefLabel "Hybrid Intelligences"@en ;
  skos:definition "Assemblages of biological, technical, social, spatial, legal, and affective processes that co-produce cognition."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "2"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Cognitive_architecture>
 .

hi:creative_embodiment a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Creative Embodiment"@en ;
  skos:prefLabel "Creative Embodiment"@en ;
  skos:definition "The project's embodiment framework: AI-mediated creative process is already embodied, situated, and relational—not a body added after the fact. The artist designs conditions of encounter; prompt, model, interface, dataset, institution, and audience form a cognitive assemblage. Necessary epistemology: the body is where abstraction becomes consequential; space situates cognition; movement temporalizes thought."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.9"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Embodied_cognition>
 .

hi:intelligence a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Intelligence"@en ;
  skos:prefLabel "Intelligence"@en ;
  skos:definition "The capacity to perceive, infer, learn, adapt, and act in relation to an environment—not a substance locked in a skull or chip, but a capacity enacted through coupling among bodies, tools, symbols, institutions, and ecologies."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.9"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Intelligence> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Intelligence>
 .

hi:embodiment a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Embodiment"@en ;
  skos:prefLabel "Embodiment"@en ;
  skos:definition "The condition of being a living body in a world—mind, affect, and meaning arising through sensorimotor engagement rather than added to a disembodied processor."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.8"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Embodied_cognition> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Embodied_cognition>
 .

hi:body a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Body"@en ;
  skos:prefLabel "Body"@en ;
  skos:definition "The lived organism—flesh, breath, gesture, and sensation—as the primary site where cognition, emotion, relation, and creative action become real and consequential."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.7"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Human_body> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Human_body>
 .

hi:hybrid_coupling a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Hybrid"@en ;
  skos:prefLabel "Hybrid"@en ;
  skos:definition "The mixing of biological, technical, social, and institutional processes within a single field of action—neither purely human nor purely machine, but co-produced across coupled agents, infrastructures, and ecologies."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.7"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Hybrid> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Hybrid>
 .

hi:assemblage a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Cognitive Assemblages"@en ;
  skos:prefLabel "Cognitive Assemblages"@en ;
  skos:definition "N. Katherine Hayles: cognition as interpretation of information within contexts that connect it with meaning—networked arrangements in which human and nonhuman cognizers exchange, process, select, and transform information, producing emergent meaning and action. Intelligence does not belong to one sovereign subject; it circulates through bodies, sensors, interfaces, datasets, institutions, and environments."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "2.05"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/N._Katherine_Hayles>
 .

hi:assemblage_form a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Assemblage"@en ;
  skos:prefLabel "Assemblage"@en ;
  skos:definition "A composition of heterogeneous parts—bodies, tools, institutions, laws, media, atmospheres—whose relations co-produce capacities and meaning. Not a collection of fixed objects, but a dynamic arrangement; related to Hayles’s cognitive assemblages and to broader assemblage thinking (Latour, Deleuze & Guattari)."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.85"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Assemblage_(philosophy)> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Assemblage_(philosophy)>
 .

hi:technosymbiosis a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Techno-symbiosis"@en ;
  skos:prefLabel "Techno-symbiosis"@en ;
  skos:definition "N. Katherine Hayles: human futures with nonhuman symbionts—biological, technical, and mixed couplings that co-evolve across substrates, institutions, and AI systems. Techno-symbiosis names interdependence without sameness: humans and machines do not collapse into one another, yet their metabolisms of information, energy, and action become mutually constitutive."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.95"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/N._Katherine_Hayles>
 .

hi:cognition a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "Cognition"@en ;
  skos:prefLabel "Cognition"@en ;
  skos:definition "Processes of knowing, perceiving, remembering, imagining, and deciding—historically located in brains, now understood as spanning bodies, environments, tools, and collectives. In this program, cognition is a world-involving practice, not an abstract operation floating above situation."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.95"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Cognition>
 .

hi:4e a owl:NamedIndividual, hi:PremiseConcept ;
  rdfs:label "4E Cognition"@en ;
  skos:prefLabel "4E Cognition"@en ;
  skos:definition "Embodied cognition as four coupled claims: Embodied (depends on sensorimotor capacities of living bodies), Embedded (emerges within environments that constrain and enable action), Enacted (organisms bring forth meaningful worlds through interaction histories), and Extended (tools, inscriptions, devices, media, and social structures can participate in cognitive processes). Challenges the classical image of mind as internal representation in a brain-computer."@en ;
  skos:broader hi:category/premise ;
  hi:inCategory hi:category/premise ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "2"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Embodied_cognition>
 .

hi:creativity a owl:NamedIndividual, hi:FrameworkConcept ;
  rdfs:label "Creativity"@en ;
  skos:prefLabel "Creativity"@en ;
  skos:definition "Margaret Boden: an idea or artifact counts as creative only when it is both novel (surprising, not obvious or routine) and valuable (worthwhile in its domain—useful, interesting, beautiful, or apt). She distinguishes combinational creativity (new combinations of familiar elements), exploratory creativity (moving within a structured conceptual space), and transformational creativity (altering the space's rules or dimensions)."@en ;
  skos:broader hi:category/framework ;
  hi:inCategory hi:category/framework ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.8"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Creativity> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Creativity>
 .

hi:enactivism a owl:NamedIndividual, hi:FrameworkConcept ;
  rdfs:label "Enactivism"@en ;
  skos:prefLabel "Enactivism"@en ;
  skos:definition "Organisms bring forth meaningful worlds through histories of interaction; cognition and world are co-emergent. Rooted in Maturana and Varela’s autopoiesis: a living system first produces itself, then a world of significance."@en ;
  skos:broader hi:category/framework ;
  hi:inCategory hi:category/framework ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.7"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Enactivism>
 .

hi:autopoiesis a owl:NamedIndividual, hi:FrameworkConcept ;
  rdfs:label "Autopoiesis"@en ;
  skos:prefLabel "Autopoiesis"@en ;
  skos:definition "Humberto Maturana and Francisco Varela: living systems as networks that continually produce and regenerate the components and boundaries that constitute them. An autopoietic unity is operationally closed—it specifies its own organization—yet structurally coupled with a medium. Cognition, in this biology of knowing, is the effective conduct of a living system in its world, not representation of a pre-given environment. Autopoiesis is the biological root of enactivism: organisms bring forth worlds because they first bring forth themselves."@en ;
  skos:broader hi:category/framework ;
  hi:inCategory hi:category/framework ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.65"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Autopoiesis> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Autopoiesis>
 .

hi:buddhism a owl:NamedIndividual, hi:FrameworkConcept ;
  rdfs:label "Buddhism"@en ;
  skos:prefLabel "Buddhism"@en ;
  skos:definition "Tradition of practice and philosophy centered on suffering, interdependence, impermanence, and liberation—mindfulness, emptiness (śūnyatā), and non-self (anattā) as frameworks for understanding cognition, ethics, and embodied experience; foundational for enactivism via phenomenology and contemplative science. Vipassana (insight) is a core method of this tradition: first-person training of attention that later informed Varela’s neurophenomenology."@en ;
  skos:broader hi:category/framework ;
  hi:inCategory hi:category/framework ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.5"^^xsd:decimal
 ;
  schema:url <essay.html> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Buddhism>
 .

