 ;
  schema:url <https://www.deeprootscreate.com/> ;
  schema:sameAs <https://en.wikipedia.org/wiki/Public_art>
 .

hi:karla a owl:NamedIndividual, hi:FacilitatorConcept ;
  rdfs:label "Karla Saldaña Ochoa"@en ;
  skos:prefLabel "Karla Saldaña Ochoa"@en ;
  skos:definition "Monday July 13 — AI and architecture. Ecuadorian architect and Assistant Professor in UF’s School of Architecture; Master of Advanced Studies in Landscape Architecture and Ph.D. from ETH Zurich on integrating artificial and human intelligence for disaster response. Leads SHARE Lab, developing human-centered AI for architectural practice at building and urban scale."@en ;
  skos:broader hi:category/facilitator ;
