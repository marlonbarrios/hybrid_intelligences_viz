hi:linear_transform a owl:NamedIndividual, hi:FrameworkConcept ;
  rdfs:label "z = Wx + b"@en ;
  skos:prefLabel "z = Wx + b"@en ;
  skos:definition "The affine transform at the heart of every dense layer: each output unit j computes zⱼ = Σᵢ wⱼᵢ xᵢ + bⱼ (matrix form z = Wx + b)—a weighted sum of inputs plus bias—before a nonlinear activation. The elementary operation of artificial neurons, shared by perceptrons, deep nets, and transformers."@en ;
  skos:broader hi:category/framework ;
  hi:inCategory hi:category/framework ;
  hi:schemeMember hi:scheme ;
  skos:inScheme hi:scheme ;
  hi:networkWeight "1.55"^^xsd:decimal
 ;
  schema:url <https://en.wikipedia.org/wiki/Artificial_neuron> ;
